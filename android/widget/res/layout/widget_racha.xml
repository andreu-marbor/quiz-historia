<?xml version="1.0" encoding="utf-8"?>
<!--
  §13.3 · Diseño del widget. Solo vistas que RemoteViews sabe dibujar
  (LinearLayout + TextView) y colores/ textos por recursos, nunca a mano:
  mismo criterio que las variables CSS en la web.
  El widget es 2×1 (una sola fila), así que el padding vertical baja de 12 a
  8dp: el contenido (título + cifra + etiqueta ≈ 70dp) tiene que caber sin
  recortarse en una celda.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingEnd="12dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/widget_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/widget_titulo"
        android:textColor="@color/widget_tenue"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_sin_racha"
            android:textColor="@color/widget_acento"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_juega"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
