        <!--
          §13.3 · Bloques del widget de la racha. Este fragmento lo inserta
          scripts/aplicar-widget.mjs justo antes del cierre de <application>;
          no se edita el manifiesto generado a mano (se regenera con
          `bubblewrap update`). El puente es `exported="true"` porque lo abre
          Chrome desde la web, y lleva BROWSABLE, que es la categoría que
          Chrome exige para lanzarlo.
        -->
        <activity
            android:name=".widget.WidgetBridgeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.andreumarbor.quizophistoria.widget.RACHA" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="racha"
                    android:scheme="quizhistoria" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WidgetRachaProvider"
            android:exported="false">
            <!--
              Este `<intent-filter>` es OBLIGATORIO: así descubre el sistema los
              widgets (consulta los receivers que escuchan `APPWIDGET_UPDATE`).
              Sin él el selector de widgets de Android no enseña la app ni por
              casualidad (incidencia del 2026-10-08). `exported="false"` no
              estorba: los envíos del sistema —el que dispara `onUpdate`— sí
              llegan a receptores no exportados.
            -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_racha" />
        </receiver>
