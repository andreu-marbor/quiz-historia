{
  "name": "quiz-historia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repaso de Historia: cuestionarios de repaso para ESO y Bachiller (PWA + TWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prueba": "npm run prueba:logica && npm run prueba:persistencia && npm run prueba:pantallas && npm run prueba:datos",
    "prueba:logica": "esbuild pruebas/logica.ts --bundle --format=esm --platform=node --outfile=node_modules/.tmp/logica.mjs --log-level=warning && node node_modules/.tmp/logica.mjs",
    "prueba:persistencia": "esbuild pruebas/persistencia.ts --bundle --format=esm --platform=node --outfile=node_modules/.tmp/persistencia.mjs --log-level=warning && node node_modules/.tmp/persistencia.mjs",
    "prueba:pantallas": "esbuild pruebas/pantallas.ts --bundle --packages=external --format=esm --platform=node --outfile=node_modules/.tmp/pantallas.mjs --log-level=warning && node node_modules/.tmp/pantallas.mjs",
    "prueba:datos": "esbuild pruebas/datos.ts --bundle --format=esm --platform=node --outfile=node_modules/.tmp/datos.mjs --log-level=warning && node node_modules/.tmp/datos.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
