<?xml version="1.0" encoding="utf-8"?>
<!--
  §13.3 · Textos del widget. En castellano como el resto de la app (sin i18n):
  mismos conceptos que `src/ui/cadenas.ts` («Racha», «días», «Juega hoy»).
  Etiquetas cortas a propósito: en un widget de 2–3 celdas no cabe nada más.
-->
<resources>
    <string name="widget_titulo">Racha</string>
    <string name="widget_dias">días</string>
    <string name="widget_juega">Juega hoy</string>
    <!-- «todavía no ha llegado ningún dato» (app recién instalada): el widget
         prefiere pedir que se abra la app antes que decir «Juega hoy» a quien
         ya ha jugado. -->
    <string name="widget_abre">Abre la app</string>
    <string name="widget_sin_racha">—</string>
    <string name="widget_descripcion">Tu racha de días seguidos de repaso.</string>
</resources>
